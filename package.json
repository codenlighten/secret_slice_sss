{
  "name": "secretslices",
  "version": "1.1.0",
  "description": "Shamir secret sharing with verified recovery: split a secret into shares, recover it from any threshold of them. Zero dependencies; Node.js and browsers.",
  "type": "module",
  "exports": {
    ".": { "types": "./types/index.d.ts", "default": "./src/index.js" },
    "./legacy": { "types": "./types/legacy.d.ts", "default": "./src/legacy.js" },
    "./legacy-password": { "types": "./types/legacy-password.d.ts", "default": "./src/legacy-password.js" },
    "./mnemonic": { "types": "./types/mnemonic.d.ts", "default": "./src/mnemonic.js" },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": { "secretslices": "src/cli.js" },
  "files": ["src", "types", "docs", "web/index.html", "CHANGELOG.md", "SECURITY.md"],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.js test/*.test.cjs",
    "build": "node scripts/build-web.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "prepack": "node scripts/build-web.mjs --check"
  },
  "engines": { "node": ">=20.19.0" },
  "repository": { "type": "git", "url": "git+https://github.com/codenlighten/secret_slice_sss.git" },
  "bugs": { "url": "https://github.com/codenlighten/secret_slice_sss/issues" },
  "homepage": "https://secretslices.com",
  "keywords": ["shamir", "secret-sharing", "sss", "threshold", "backup", "mnemonic", "bip39", "crypto"],
  "author": "Gregory J. Ward <greg@smartledger.technology>",
  "license": "MIT"
}
